# Copy to .env locally; never commit .env or send secrets in chat.
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://127.0.0.1:5000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ashri_ventures_test
SESSION_SECRET=Akash7248351082!abc
PGSSL=false

# Recharge / bill payment provider — keep disabled until official adapter is implemented.
UTILITY_PROVIDER_MODE=disabled
UTILITY_PROVIDER_BASE_URL=
UTILITY_PROVIDER_API_KEY=
UTILITY_PROVIDER_API_SECRET=
UTILITY_PROVIDER_WEBHOOK_SECRET=

# WhatsApp Cloud API — credentials must remain server-side.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_UTILITY_STATUS_TEMPLATE=utility_transaction_status
WHATSAPP_TEMPLATE_LANGUAGE=en

# MaxusPay recharge/WhatsApp API from supplied PDF. Use provider-confirmed SANDBOX host only.
MAXUSPAY_MODE=disabled
MAXUSPAY_BASE_URL=
MAXUSPAY_USER_ID=
MAXUSPAY_TOKEN_ID=

# DMT / bank transfer API from supplied PDF. PDF uses WebsiteName placeholder; get official sandbox host.
DMT_MODE=disabled
DMT_BASE_URL=
DMT_USER_ID=
DMT_TOKEN_ID=
